@model Web_Subasta.Models.ViewModels.ProductoViewModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Productos</title>
    <link rel="stylesheet" href="~/css/styles.css">
</head>
<body>
    <div class="container">
        <h1>Mis Productos</h1>
        <div class="productos-container">

            @foreach (var producto in Model.productoUsuario)
            {
                <div class="card">
                    <img src="@producto.ImagenUrl" alt="@producto.nombreProducto" />
                    <h2> @producto.nombreProducto</h2>
                    <p>@producto.descripcion</p>
                    <p class="price">Precio Base: $@producto.precioBase.ToString("N0")</p>
                    <p class="status">Estado: @producto.estadoProducto</p>
                    <button class="ver-btn">Ver</button>
                </div>
            }
        </div>

        <button id="nuevaVentaBtn" class="nueva-venta-btn">NUEVA VENTA</button>
    </div>
</body>
</html>