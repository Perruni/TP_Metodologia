<style>
    /* Contenedor principal de la subasta */
    .subasta-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
        background-color: #f3f3f3;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        font-family: Arial, sans-serif;
    }

    /* Encabezado */
    .subasta-header h2 {
        font-size: 24px;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
    }

    /* Contenido principal */
    .subasta-content {
        display: flex;
        gap: 20px;
    }

    /* Imagen del producto */
    .subasta-imagen img {
        width: 100%;
        height: auto;
        max-width: 300px;
        border-radius: 8px;
    }

    /* Detalles de la subasta */
    .subasta-detalles {
        flex: 1;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 8px;
        font-size: 16px;
        color: #333;
    }

        .subasta-detalles .precio-base {
            color: #e74c3c;
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 10px;
        }

        .subasta-detalles .cantidad-ofertas {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .subasta-detalles .descripcion {
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 20px;
            color: #666;
        }

    /* Acciones de la subasta */
    .subasta-acciones {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .subasta-acciones input[type="number"] {
            flex: 1;
            padding: 10px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .subasta-acciones .btn-monto {
            background-color: #7f8c8d;
            color: white;
            font-weight: bold;
            padding: 10px 15px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
        }

        .subasta-acciones .btn-remover {
            background-color: #e74c3c;
            color: white;
            font-weight: bold;
            padding: 10px 15px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
        }
</style>

<div class="subasta-container">
    <!-- Título-->
    <div class="subasta-header">
        <h2>Subasta de Casa Residencial</h2>
    </div>

    <div class="subasta-content">
        <!-- Imagen y fechas -->
        <div class="subasta-imagen">
            <img src="https://via.placeholder.com/300" alt="Imagen de la casa">
            <p style="text-align: center; font-weight: bold;">Casa residencial</p>
            <p style="text-align: center; color: #777;">Inicio: 14:00 04/06/2023</p>
            <p style="text-align: center; color: #777;">Finaliza: 15:00 05/06/2023</p>
        </div>

        <!-- Detalles -->
        <div class="subasta-detalles">
            <p class="precio-base">PRECIO BASE: 1,000.000</p>
            <p class="cantidad-ofertas">CANTIDAD DE OFERTAS: 10</p>
            <p class="descripcion">Una casa pequeña de estilo moderno, con fachada de color blanco y detalles en madera. Tiene grandes ventanales que permiten la entrada de luz natural. En el interior, cuenta con una sala de estar acogedora, una cocina compacta y funcional, dos habitaciones, y un baño. El patio trasero es amplio.</p>

            <!--Boton remover  -->
            <div class="subasta-acciones">
                <button class="btn-remover">REMOVER</button>
            </div>
        </div>
    </div>
</div>
