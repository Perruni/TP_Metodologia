@model Web_Subasta.Models.ViewModels.SubastaViewModel
@{
    Layout = "_Layout";
    
    ViewData["Title"] = "Subastas Activas";
}
   
    <div class="container mt-5">
        <div class="row">
        @foreach (var subasta in Model.subastaLista)
        {
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Subasta: @subasta.titulo</h5>
                        <p class="card-text">Fecha de inicio: @subasta.fechaInicio.ToShortDateString()</p>
                        <p class="card-text">Fecha de fin: @subasta.fechaFinalizado.ToShortDateString()</p>
                        <p class="card-text">Estado: @subasta.estadoSubasta.ToString()</p>
                        <p class="card-text">Método de Pago: @subasta.metodosdePago.ToString()</p>
                        <a as href="#" class="btn btn-primary">Participar en la subasta</a>
                    </div>
                </div>
            </div>
        }

        </div>
    </div>

