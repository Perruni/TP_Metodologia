@model Web_Subasta.Models.ViewModels.ProductoViewModel

@{
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Titulo</title>

    <!-- CSS dentro de la vista -->
    <style>
        /* General */
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            color: #333;
            margin: 0;
            padding: 0;
        }

        /* Card */
        .card {
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin: 20px auto;
            width: 70%;
            padding: 30px;
        }

        /* Card Header */
        .card-header {
            background-color: #6e6158;
            color: #FFFFFF;
            padding: 20px;
            text-align: center;
        }

        /* Container for image and data */
        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: space-between;
        }

        /* Image Section */
        .image-container {
            flex: 1;
            text-align: center;
            max-width: 450px;
        }

        .product-image {
            max-width: 100%;
            height: auto;
            width: 400px; /* Fija un tamaño de imagen de 300px de ancho */
            border-radius: 8px;
            object-fit: cover; /* Asegura que la imagen se recorte correctamente si tiene una gran calidad */
        }

        /* Product Data Section */
        .data-container {
            flex: 2;
            max-width: 500px;
        }

        /* Títulos y Descripción */
        h3, h4 {
            margin: 30px 0;
        }

        h4 {
            color: #6e6158;
        }

        p {
            margin: 5px 0;
        }

        .description-box {
            border: 2px solid #796e64; /* Borde de color marrón claro */
            background-color: #f4f4f4; /* Fondo gris claro */
            padding: 20px;
            border-radius: 8px; /* Bordes redondeados */
            margin-top: 10px;
        }
        hr {
            margin: 10px 0;
            border: 0;
            border-top: 2px solid #796e64;
        }

        /* Formulario de Ofertas */
        .form-container {
            margin-top: 60px;
            text-align: center;
        }

        .offer-input {
            padding: 15px;
            font-size: 18px;
            width: 70%; /* Aumenta el ancho del input */
            margin: 15px 0;
            border-radius: 5px;
            border: 1px solid #ccc;
            box-sizing: border-box;
        }

        .btn-submit {
            padding: 15px 30px;
            background-color: #6e6158;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 18px;
            transition: background-color 0.3s ease;
        }

            .btn-submit:hover {
                background-color: #5a4b3b;
            }

        /* Mensajes de error */
        .text-danger {
            color: #d9534f;
            text-align: center;
            font-size: 16px;
            margin-top: 20px;
        }

        /* Añadir más espaciado entre las secciones */
        hr {
            margin-top: 30px;
        }
    </style>
</head>
<body>
    
    <div class="card">
        <!-- Header de la tarjeta -->
        <div class="card-header">
           
            <h2 style="color: #FFFFFF;">@Model.Titulo</h2>  <!-- Cambiar color del título aquí -->
        </div>

        <div class="container">
            <!-- Sección de imagen y fechas -->
            <div class="image-container">
                <img src="@($"https://tpimetodologiaimagenes.blob.core.windows.net/contenedorimagenes/{Model.Producto.ImagenUrl}")" alt="Imagen del producto" class="product-image" />
                <p><strong>Inicia:</strong> @Model.fechaInicio.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Finaliza:</strong> @Model.fechaFinalizado.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            <!-- Sección de datos del producto -->
            <div class="data-container">
                <h3>@Model.NombreProducto</h3>
                <div class="description-box">
                    <p><strong>Cantidad de Ofertas:</strong>@Model.CantidadOfertas<p>
                </div>
                <hr />
                
                <div class="description-box">
                    <h4>Precio Base: @Model.PrecioBase.ToString("N")</h4>
                </div>
                
                <div class="description-box">
                    <p><strong>Descripción:</strong></p>
                    <p>@Model.Descripcion</p>
                </div>
            </div>
        </div>

        <!-- Formulario de ofertas -->
        @if (User.Identity.IsAuthenticated)
        {
            if (Model.EstadoProducto == Core.Entities.Producto.EstadoProducto.EnSubasta)
            {
                <div class="form-container">
                    <h4>Realiza una oferta</h4>
                    <form asp-controller="Oferta" asp-action="PostOferta" method="post">
                        <input type="hidden" name="productoID" value="@Model.ProductoID" />
                        <label for="montoOferta">Monto a Ofertar:</label>
                        <input type="number" id="montoOferta" name="montoOferta" step="0.01" value="0" required class="offer-input" />
                        <button type="submit" class="btn-submit">Ofertar</button>
                    </form>
                </div>
            }
            else
            {
                <p class="text-danger">Este producto no está en subasta, por lo que no se pueden realizar ofertas.</p>
            }
        }
        else if (Model.EstadoProducto == Core.Entities.Producto.EstadoProducto.EnSubasta)
        {
            <p class="text-danger">Debes estar autenticado para realizar una oferta.</p>
        }
        @if (Model.EsSubastaFinalizada)
        {
            <p><strong>El ganador es : </strong> @Model.NombreGanador<strong> ! </strong></p>
        }

        @if ((Model.EsSubastaFinalizada && Model.EsVendedor) || (Model.EsSubastaFinalizada && Model.EsGanador))
        {
            <div class="form-container">
                <form method="get" action="@Url.Action("Certificado", "Producto", new { id = Model.ProductoID })">
                    <input type="hidden" name="productoID" value="@Model.ProductoID" />
                    <button type="submit" class="btn-submit">Ver Certificado</button>
                </form>
            </div>
        }

    </div>
</body>
</html>
