@model Web_Subasta.Models.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Productos de la Subasta";
}


@if (Model != null)
{
    <div class="subasta-info text-center mb-5">
        <h3 class="subasta-titulo">@Model.Titulo</h3>

        <p class="text-muted">@Model.Subasta.estadoSubasta</p>

        <div class="d-flex justify-content-center">
            <div class="mx-4">
                <strong>Fecha de Inicio:</strong>
                <span class="text-primary">@Model.fechaInicio.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="mx-4">
                <strong>Fecha de Finalización:</strong>
                <span class="text-danger">@Model.fechaFinalizado.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>

    @if (Model.productoUsuario != null && Model.productoUsuario.Any())
    {

        <div class="row">
            @foreach (var producto in Model.productoUsuario)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-lg">
                        <div class="card-body">
                            <img src="@($"https://tpimetodologiaimagenes.blob.core.windows.net/contenedorimagenes/{producto.ImagenUrl}")"/>
                            <h5 class="card-title">@producto.nombreProducto</h5>
                            <p class="card-text">@producto.descripcion</p>
                            <p><strong>Precio Base:</strong> @producto.precioBase.ToString("C")</p>
                            <p><strong>Método de Entrega:</strong> @producto.metodoEntrega</p>
                        </div>
                        <div class="card-footer text-center">
                            <a asp-controller="Producto"
                               asp-action="GetDetallesProducto"
                               asp-route-productoID="@producto.productoID"
                               class="btn btn-primary">
                                Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center">No hay productos activos para esta subasta.</p>
    }
}
else
{
    <p class="text-center text-danger">Subasta no encontrada.</p>
}